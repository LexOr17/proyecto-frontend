{
    "angular-schematics.schematicsDefaultOptions": {
        "angular-*": {
            "externalTemplate": true
        },
        "angular-component": {
            "skipChangeDetectionOnPush": true
        },
        "angular-page": {
            "skipChangeDetectionOnPush": true
        }
    },
    "git.timeline.showAuthor": false,
    "git.blame.editorDecoration.template": "${subject}",
    "git.blame.statusBarItem.template": "${authorName} ",
    "github.showAvatar": false
}